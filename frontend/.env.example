# Copy to .env.local on your machine. .env.local is gitignored and is the ONLY place this flag may be set
# (docs/plans/hotel-site-check-plan.md: local-only, never in a workflow, Dockerfile or compose file).
# NEXT_PUBLIC_SITECHECK_ENABLED=true
# Backend origin the Next.js dev server proxies /api/site-checks to (default http://localhost:8080):
# HOTEL_CHECK_API_URL=http://localhost:8080
